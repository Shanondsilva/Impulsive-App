<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12 and later. Include-only mode: nothing outside
    this list is backed up or transferred. Cloud backup is disabled entirely
    on devices without client-side encryption capabilities, so the backup
    either travels end-to-end encrypted with the user's lock screen secret
    or does not travel at all. Device-to-device transfer carries the same
    set and never goes through a server. The raw SQLCipher database and its
    passphrase store are never included because their keys are bound to the
    device's Keystore and cannot restore onto another device.

    Deliberately excluded by omission: impulsive.db, the
    impulsive_database_passphrase SharedPreferences, app_lock_prefs (the app
    lock PIN is set fresh on a new device), premium_entitlement (Play
    Billing re-verifies server-side), focus_session, and
    protection_window_notifications (transient runtime state), plus all
    Firebase, cache, and log files.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="restore/impulsive_restore_bundle_v1.json" />
        <include domain="file" path="datastore/app_settings_prefs.preferences_pb" />
        <include domain="file" path="datastore/focus_setup.preferences_pb" />
        <include domain="file" path="datastore/game_store_prefs.preferences_pb" />
        <include domain="file" path="datastore/home_guide.preferences_pb" />
        <include domain="file" path="datastore/level_prefs.preferences_pb" />
        <include domain="file" path="datastore/onboarding_state.preferences_pb" />
        <include domain="file" path="datastore/play_store_rating_prompt.preferences_pb" />
        <include domain="file" path="datastore/protection_setup_state.preferences_pb" />
        <include domain="file" path="datastore/reflex_game_history.preferences_pb" />
        <include domain="file" path="datastore/reset_read_progress.preferences_pb" />
        <include domain="file" path="datastore/rhythm_tiles_history.preferences_pb" />
        <include domain="file" path="datastore/snake_game_history.preferences_pb" />
        <include domain="file" path="datastore/score_sessions.preferences_pb" />
        <include domain="file" path="datastore/served_games.preferences_pb" />
        <include domain="file" path="datastore/taper_preferences.preferences_pb" />
        <include domain="file" path="datastore/task_rewards.preferences_pb" />
        <include domain="file" path="datastore/theme_prefs.preferences_pb" />
        <include domain="file" path="datastore/urge_events.preferences_pb" />
        <include domain="file" path="datastore/window_outcomes.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="restore/impulsive_restore_bundle_v1.json" />
        <include domain="file" path="datastore/app_settings_prefs.preferences_pb" />
        <include domain="file" path="datastore/focus_setup.preferences_pb" />
        <include domain="file" path="datastore/game_store_prefs.preferences_pb" />
        <include domain="file" path="datastore/home_guide.preferences_pb" />
        <include domain="file" path="datastore/level_prefs.preferences_pb" />
        <include domain="file" path="datastore/onboarding_state.preferences_pb" />
        <include domain="file" path="datastore/play_store_rating_prompt.preferences_pb" />
        <include domain="file" path="datastore/protection_setup_state.preferences_pb" />
        <include domain="file" path="datastore/reflex_game_history.preferences_pb" />
        <include domain="file" path="datastore/reset_read_progress.preferences_pb" />
        <include domain="file" path="datastore/rhythm_tiles_history.preferences_pb" />
        <include domain="file" path="datastore/snake_game_history.preferences_pb" />
        <include domain="file" path="datastore/score_sessions.preferences_pb" />
        <include domain="file" path="datastore/served_games.preferences_pb" />
        <include domain="file" path="datastore/taper_preferences.preferences_pb" />
        <include domain="file" path="datastore/task_rewards.preferences_pb" />
        <include domain="file" path="datastore/theme_prefs.preferences_pb" />
        <include domain="file" path="datastore/urge_events.preferences_pb" />
        <include domain="file" path="datastore/window_outcomes.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
