<resources>
    <!-- API 31+: system reads android:windowSplashScreen* natively. -->
    <style name="Theme.Impulsive" parent="Theme.SplashScreen">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- Matches splash background — no two-tone flash. -->
        <item name="android:windowBackground">#F3FBF6</item>
        <item name="android:colorAccent">#93E9BE</item>
        <item name="android:statusBarColor">#F3FBF6</item>
        <item name="android:navigationBarColor">#F3FBF6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">#F3FBF6</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
    </style>
</resources>
