rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /*
     * All Firestore access is server-only. Cloud Functions use the Firebase
     * Admin SDK, which bypasses these rules by design. The Android client
     * has no direct Firestore access:
     *
     * - Plus entitlement is verified through the verifyPlusSubscription
     *   callable function and cached locally on the device.
     * - Account deletion runs through the eraseUserData callable function,
     *   which removes the user document, journalNotes and their
     *   checklistItems, recoverySessions, syncTombstones, and
     *   playPurchaseTokens records server-side.
     * - Recovery progress and behavioural data are never written to
     *   Firestore. They live only on the user's device.
     *
     * Every client read and write is therefore denied.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
